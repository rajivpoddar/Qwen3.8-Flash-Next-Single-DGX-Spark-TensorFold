FROM debian:bookworm-slim@sha256:3783cc01769c7b2b1b83a5c5ad96c815348e28ed7da68e2e3687004faa906251
# Verified official Linux/aarch64 no-plugin release, not a floating latest tag.
COPY cli-proxy-api /usr/local/bin/cliproxyapi
WORKDIR /config
ENTRYPOINT ["/usr/local/bin/cliproxyapi"]
CMD ["-config", "/config/config.yaml", "-local-model"]
