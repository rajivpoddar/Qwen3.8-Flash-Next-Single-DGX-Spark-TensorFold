config-version: 8
server:
  host: 127.0.0.1
  port: 30001
management:
  allow-remote: false
  secret-key: ""
  disable-control-panel: true
access:
  api-keys:
    - ${INTERNAL_KEY_JSON}
routing:
  retry:
    request-retry: 0
  cooldown:
    disable-cooling: true
requests:
  streaming:
    keepalive-seconds: 15
    bootstrap-retries: 0
api-keys:
  openai-compatibility:
    - name: tensorfold-spark
      base-url: http://127.0.0.1:8888/v1
      proxy-url: direct
      keys:
        - api-key: none
      models:
        - name: qwen3.8-flash-next
          alias: qwen3.8-flash-next
          max-context-length: 262144
          input-modalities: [text]
          output-modalities: [text]
          is-compat: true
          thinking:
            levels: [none, low, medium, high, xhigh]
oauth:
  auth-dir: /config/empty-auths
  providers:
    claude:
      claude-code:
        disable-cloaking-model-list: true
observability:
  logs:
    debug: false
    request-log: false
