FROM tensorfold-spark:v0.6.0-victoria-v3
ARG PATCH_SHA256
RUN git clone --depth 1 --branch v0.6.1 https://github.com/ashhart/TensorFold.git /opt/tensorfold-0.6.1 && \
    test "$(git -C /opt/tensorfold-0.6.1 rev-parse HEAD)" = "17c73e189f5e6a5304cda7ea37f086f9c49b4788"
COPY spark/patches/tf061-tinfield.patch /opt/spark/tf061-tinfield.patch
COPY spark/test_prompt_copy.py /opt/spark/test_prompt_copy.py
RUN test "$(sha256sum /opt/spark/tf061-tinfield.patch | cut -d' ' -f1)" = "$PATCH_SHA256" && \
    cd /opt/tensorfold-0.6.1 && \
    git apply --check --directory=src /opt/spark/tf061-tinfield.patch && \
    git apply --directory=src /opt/spark/tf061-tinfield.patch && \
    python -m pip install --no-deps --no-build-isolation --no-cache-dir /opt/tensorfold-0.6.1 && \
    python /opt/spark/test_prompt_copy.py --installed && \
    python -m compileall -q /usr/local/lib/python3.12/dist-packages/tensorfold && \
    python -c "import tensorfold; assert tensorfold.__version__ == '0.6.1'" && \
    tensorfold --version && tensorfold serve --help >/dev/null
LABEL org.opencontainers.image.source="https://github.com/ashhart/TensorFold"
LABEL org.opencontainers.image.revision="17c73e189f5e6a5304cda7ea37f086f9c49b4788"
LABEL spark.tensorfold_version="0.6.1"
LABEL spark.tensorfold_compatibility="scoped-loading-estimate-and-verified-prompt-copy"
